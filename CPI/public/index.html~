CTYPE html>
<html lang="en">
	<head>
		  <meta charset="UTF-8">
		    <meta name="viewport" content="width=device-width, initial-scale=1.0">
		      <title>Image CAPTCHA</title>
		        <style>
    .captcha-container {
	          display: flex;
		        flex-wrap: wrap;
			      width: 400px;
			            margin: 0 auto;
				        }
        .captcha-image {
		      width: 100px;
		            height: 100px;
			          margin: 10px;
				        cursor: pointer;
					      border: 2px solid transparent;
					          }
	    .selected {
		          border: 2px solid #0a74da;
			      }
	        #captcha-message {
			      text-align: center;
			            margin-top: 20px;
				        }
		  </style>
	</head>
	<body>
		  <div class="captcha-container">
			      <img src="cat1.jpg" class="captcha-image" alt="image1" data-tag="cat">
			          <img src="dog1.jpg" class="captcha-image" alt="image2" data-tag="dog">
				      <img src="cat2.jpg" class="captcha-image" alt="image3" data-tag="cat">
				          <img src="dog2.jpg" class="captcha-image" alt="image4" data-tag="dog">
					      <img src="cat3.jpg" class="captcha-image" alt="image5" data-tag="cat">
					        </div>
						  <div id="captcha-message">Select all images with cats</div>

						    <button onclick="verifyCaptcha()">Verify</button>

						      <script src="image-captcha.js"></script>
	</body>
</html>


